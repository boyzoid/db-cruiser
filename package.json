{
  "name": "db-cruiser",
  "displayName": "DB Cruiser",
  "description": "A database explorer and SQL console for VS Code.",
  "version": "0.4.6",
  "publisher": "stroz-dot-dev",
  "author": "The Stroz",
  "license": "MIT",
  "repository": "https://github.com/boyzoid/db-cruiser",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Data Science",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "database",
    "sql",
    "mysql",
    "database-explorer",
    "schema-browser",
    "sql-console",
    "query-runner",
    "data-grid"
  ],
  "activationEvents": [
    "onView:dbCruiser.connections",
    "onCommand:dbCruiser.addMySqlConnection",
    "onCommand:dbCruiser.editConnection",
    "onCommand:dbCruiser.openSqlConsole",
    "onCommand:dbCruiser.runQuery",
    "onCommand:dbCruiser.explainQuery",
    "onCommand:dbCruiser.selectSchema",
    "onCommand:dbCruiser.refresh",
    "onCommand:dbCruiser.refreshConnection",
    "onCommand:dbCruiser.removeConnection",
    "onCommand:dbCruiser.testConnection",
    "onCommand:dbCruiser.manageUsers",
    "onCommand:dbCruiser.inspectObject",
    "onCommand:dbCruiser.selectTop100",
    "onCommand:dbCruiser.copyQualifiedName",
    "onCommand:dbCruiser.copyCreateStatement",
    "onCommand:dbCruiser.generateSelectStatement",
    "onCommand:dbCruiser.generateInsertStatement",
    "onCommand:dbCruiser.generateUpdateStatement",
    "onCommand:dbCruiser.generateDeleteStatement",
    "onCommand:dbCruiser.generateJoinSelectStatement"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbCruiser",
          "title": "DB Cruiser",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "dbCruiser": [
        {
          "id": "dbCruiser.connections",
          "name": "Connections",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "dbCruiser.addMySqlConnection",
        "title": "DB Cruiser: Add MySQL Connection",
        "icon": "$(database)"
      },
      {
        "command": "dbCruiser.refresh",
        "title": "DB Cruiser: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "dbCruiser.refreshConnection",
        "title": "DB Cruiser: Refresh Connection",
        "icon": "$(refresh)"
      },
      {
        "command": "dbCruiser.removeConnection",
        "title": "DB Cruiser: Remove Connection",
        "icon": "$(trash)"
      },
      {
        "command": "dbCruiser.editConnection",
        "title": "DB Cruiser: Edit Connection",
        "icon": "$(edit)"
      },
      {
        "command": "dbCruiser.testConnection",
        "title": "DB Cruiser: Test Connection",
        "icon": "$(plug)"
      },
      {
        "command": "dbCruiser.manageUsers",
        "title": "DB Cruiser: Manage Users",
        "icon": "$(account)"
      },
      {
        "command": "dbCruiser.openSqlConsole",
        "title": "DB Cruiser: Open SQL Console",
        "icon": "$(terminal)"
      },
      {
        "command": "dbCruiser.runQuery",
        "title": "DB Cruiser: Run Query",
        "icon": "$(play)"
      },
      {
        "command": "dbCruiser.explainQuery",
        "title": "DB Cruiser: Explain Query",
        "icon": "$(graph)"
      },
      {
        "command": "dbCruiser.selectSchema",
        "title": "DB Cruiser: Select Console Schema",
        "icon": "$(database)"
      },
      {
        "command": "dbCruiser.inspectObject",
        "title": "DB Cruiser: Inspect Object",
        "icon": "$(inspect)"
      },
      {
        "command": "dbCruiser.selectTop100",
        "title": "DB Cruiser: Open Data View",
        "icon": "$(run)"
      },
      {
        "command": "dbCruiser.copyQualifiedName",
        "title": "DB Cruiser: Copy Qualified Name",
        "icon": "$(copy)"
      },
      {
        "command": "dbCruiser.copyCreateStatement",
        "title": "DB Cruiser: Copy CREATE Statement",
        "icon": "$(clippy)"
      },
      {
        "command": "dbCruiser.generateSelectStatement",
        "title": "DB Cruiser: Generate SELECT Statement",
        "icon": "$(code)"
      },
      {
        "command": "dbCruiser.generateInsertStatement",
        "title": "DB Cruiser: Generate INSERT Statement",
        "icon": "$(add)"
      },
      {
        "command": "dbCruiser.generateUpdateStatement",
        "title": "DB Cruiser: Generate UPDATE Statement",
        "icon": "$(edit)"
      },
      {
        "command": "dbCruiser.generateDeleteStatement",
        "title": "DB Cruiser: Generate DELETE Statement",
        "icon": "$(trash)"
      },
      {
        "command": "dbCruiser.generateJoinSelectStatement",
        "title": "DB Cruiser: Generate JOIN SELECT Statement",
        "icon": "$(references)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dbCruiser.addMySqlConnection",
          "when": "view == dbCruiser.connections",
          "group": "navigation@1"
        },
        {
          "command": "dbCruiser.refresh",
          "when": "view == dbCruiser.connections",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "dbCruiser.openSqlConsole",
          "when": "view == dbCruiser.connections && viewItem =~ /connection/",
          "group": "inline@1"
        },
        {
          "command": "dbCruiser.openSqlConsole",
          "when": "view == dbCruiser.connections && viewItem =~ /schema/",
          "group": "inline@1"
        },
        {
          "command": "dbCruiser.testConnection",
          "when": "view == dbCruiser.connections && viewItem =~ /connection/",
          "group": "inline@4"
        },
        {
          "command": "dbCruiser.editConnection",
          "when": "view == dbCruiser.connections && viewItem =~ /connection/",
          "group": "inline@5"
        },
        {
          "command": "dbCruiser.removeConnection",
          "when": "view == dbCruiser.connections && viewItem =~ /connection/",
          "group": "inline@6"
        },
        {
          "command": "dbCruiser.manageUsers",
          "when": "view == dbCruiser.connections && viewItem =~ /connection/",
          "group": "inline@2"
        },
        {
          "command": "dbCruiser.refreshConnection",
          "when": "view == dbCruiser.connections && viewItem =~ /connection/",
          "group": "inline@3"
        },
        {
          "command": "dbCruiser.selectTop100",
          "when": "view == dbCruiser.connections && viewItem =~ /object:table/",
          "group": "inline@1"
        },
        {
          "command": "dbCruiser.openSqlConsole",
          "when": "view == dbCruiser.connections && viewItem =~ /object:table/",
          "group": "inline@2"
        },
        {
          "command": "dbCruiser.inspectObject",
          "when": "view == dbCruiser.connections && viewItem =~ /object:/",
          "group": "inline@3"
        },
        {
          "command": "dbCruiser.copyQualifiedName",
          "when": "view == dbCruiser.connections && viewItem =~ /object:/",
          "group": "copy@1"
        },
        {
          "command": "dbCruiser.copyQualifiedName",
          "when": "view == dbCruiser.connections && viewItem =~ /^column$/",
          "group": "copy@1"
        },
        {
          "command": "dbCruiser.copyCreateStatement",
          "when": "view == dbCruiser.connections && viewItem =~ /object:/",
          "group": "copy@2"
        },
        {
          "command": "dbCruiser.generateSelectStatement",
          "when": "view == dbCruiser.connections && viewItem =~ /object:/",
          "group": "generate@1"
        },
        {
          "command": "dbCruiser.generateJoinSelectStatement",
          "when": "view == dbCruiser.connections && viewItem =~ /object:table/",
          "group": "generate@2"
        },
        {
          "command": "dbCruiser.generateJoinSelectStatement",
          "when": "view == dbCruiser.connections && viewItem =~ /^foreignKey$/",
          "group": "generate@2"
        },
        {
          "command": "dbCruiser.generateInsertStatement",
          "when": "view == dbCruiser.connections && viewItem =~ /object:table/",
          "group": "generate@3"
        },
        {
          "command": "dbCruiser.generateUpdateStatement",
          "when": "view == dbCruiser.connections && viewItem =~ /object:table/",
          "group": "generate@4"
        },
        {
          "command": "dbCruiser.generateDeleteStatement",
          "when": "view == dbCruiser.connections && viewItem =~ /object:table/",
          "group": "generate@5"
        }
      ],
      "editor/title": [
        {
          "command": "dbCruiser.selectSchema",
          "when": "editorLangId == sql",
          "group": "navigation@1"
        },
        {
          "command": "dbCruiser.runQuery",
          "when": "editorLangId == sql",
          "group": "navigation@2"
        },
        {
          "command": "dbCruiser.explainQuery",
          "when": "editorLangId == sql",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "dbCruiser.selectSchema",
          "when": "editorLangId == sql",
          "group": "navigation@1"
        },
        {
          "command": "dbCruiser.runQuery",
          "when": "editorLangId == sql",
          "group": "navigation@2"
        },
        {
          "command": "dbCruiser.explainQuery",
          "when": "editorLangId == sql",
          "group": "navigation@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dbCruiser.runQuery",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == sql"
      }
    ],
    "configuration": {
      "title": "DB Cruiser",
      "properties": {
        "dbCruiser.mysql.maxRows": {
          "type": "number",
          "default": 500,
          "minimum": 1,
          "maximum": 10000,
          "description": "Maximum rows displayed for ad hoc MySQL query results."
        }
      }
    }
  },
  "dependencies": {
    "mysql2": "^3.0.0",
    "ssh2": "^1.17.0"
  },
  "scripts": {
    "lint": "node --check src/extension.js",
    "test": "node --check src/extension.js"
  }
}
